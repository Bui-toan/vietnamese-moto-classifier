# Bytecode & Cache của Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Cache đồ họa Matplotlib
*/.mpl_cache/
.mpl_cache/

# Dữ liệu ảnh nặng (Dataset images - Không đẩy lên Git)
data/raw/
data/processed/
data/test_frozen/
data/test_frozen_copy/
*.jpg
*.jpeg
*.png
# Ngoại lệ: Giữ lại ảnh chụp màn hình bằng chứng UI và biểu đồ báo cáo
!evidence/screenshots/*.png
!evidence/*.png
!reports/*/*.png

# Cho phép file manifest quản lý danh sách ảnh
!data/manifest.csv

# File trọng số mô hình lớn (Trọng số nộp qua link Google Drive hoặc lưu local)
*.pt
*.pth
*.pkl
models/*_train.npz
models/*_val.npz

# Ngoại lệ: Giữ lại các file stats Z-score nhẹ và checkpoint chính trong models/ để suy luận
!models/*_stats.npz
!models/m1_hog_svm.npz
!models/m2_cnn1.pt
!models/m3_cnn2.pt

# File hệ thống & IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.bak

# Môi trường ảo
venv/
.venv/
env/
